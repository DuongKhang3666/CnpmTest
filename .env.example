# Sao chép thành .env rồi chỉnh. docker compose tự đọc file này.
DB_PASSWORD=commentary
# --- Đăng nhập quản trị (BẮT BUỘC đặt khi triển khai thật) ---
# Mọi API quản trị (/sites, /narrations, /api/admin/**...) đều cần đăng nhập.
ADMIN_EMAIL=admin@gmail.com
# Để trống = Back-end sinh mật khẩu ngẫu nhiên và in ra log mỗi lần khởi động (xem: docker compose logs backend).
ADMIN_PASSWORD=
# Khoá ký token đăng nhập, >= 16 ký tự ngẫu nhiên (ví dụ: openssl rand -hex 24). Để trống = đăng nhập lại sau mỗi lần restart.
ADMIN_TOKEN_SECRET=
# (Tuỳ chọn) khoá cho script/CI gọi API quản trị qua header X-Admin-Key. Để trống = tắt.
ADMIN_API_KEY=
# (Tuỳ chọn) Origin được phép gọi API từ trình duyệt, ngoài localhost và mạng nội bộ. Ví dụ: https://admin.example.com
CORS_ALLOWED_ORIGINS=
BACKEND_PORT=3000
MYSQL_PORT=3307
# Dịch thuật qua LibreTranslate (bật profile "translate" để chạy kèm)
TRANSLATE_ENABLED=true
LIBRETRANSLATE_URL=http://libretranslate:5000
# Chỉ cho thiết bị trong mạng nội bộ (Wi-Fi/LAN) quét QR vào hệ thống. Đặt false khi triển khai lên Internet.
USER_LAN_ONLY=true
# IP/tên miền đưa vào link QR của admin. Chạy trong Docker không tự biết IP LAN của máy, nên đặt tại đây
# (ví dụ 192.168.1.10). Để trống = lấy địa chỉ trang admin đang mở.
PUBLIC_HOST=
