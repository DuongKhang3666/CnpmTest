|Người dùng|
start
:Chọn chức năng\n(nghe / xem lịch sử / xem yêu thích / thêm-bỏ yêu thích);
|Hệ thống|
if (Chức năng nào?) then (Nghe thuyết minh)
  :Phát nội dung thuyết minh;
  :Ghi lịch sử nghe\nvà tăng lượt nghe;
elseif () then (Xem lịch sử)
  :Truy vấn và hiển thị danh sách\nđã nghe (mới nhất trước);
elseif () then (Xem yêu thích)
  :Tải và hiển thị\ndanh sách yêu thích;
else (Thêm / bỏ yêu thích)
  if (Nội dung đã được yêu thích?) then (Rồi)
    :Xóa khỏi danh sách yêu thích;
  else (Chưa)
    :Thêm vào danh sách yêu thích;
  endif
  :Cập nhật biểu tượng và thông báo;
endif
if (Thao tác thành công?) then (Có)
  :Hiển thị kết quả cho người dùng;
else (Lỗi mạng / phiên hết hạn)
  :Thông báo lỗi kết nối hoặc\nyêu cầu quét lại QR đăng nhập;
endif
stop

@enduml
