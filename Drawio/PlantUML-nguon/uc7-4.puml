@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #222222
skinparam ActivityBackgroundColor #EFEFEF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #EFEFEF
skinparam ActivityDiamondBorderColor #333333
skinparam ActivityBarColor #333333
skinparam UseCaseBackgroundColor #EFEFEF
skinparam UseCaseBorderColor #333333
skinparam ActorBackgroundColor #EFEFEF
skinparam ActorBorderColor #333333
skinparam RectangleBackgroundColor white
skinparam RectangleBorderColor #333333
skinparam ParticipantBackgroundColor #E6E6F5
skinparam ParticipantBorderColor #555555
skinparam DatabaseBackgroundColor #E6E6F5
skinparam DatabaseBorderColor #555555
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBorderColor #333333
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #888888
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
actor "Người dùng" as User
participant "Ứng dụng\n(web / mobile)" as APP
participant SessionInterceptor as SI
participant UserNarrationController as NC
participant NarrationService as NS
participant ContentService as CS
participant TranslationService as TS
participant UserActivityController as AC
participant ActivityService as AS
database MySQL as DB
User -> APP : Bật GPS tự động, cấp quyền vị trí
APP -> APP : watchPosition: nhận vị trí liên tục
User -> APP : Đi vào vùng bán kính của địa điểm
APP -> APP : So khớp với vùng GPS trong catalog\n(vào vùng lần đầu / ra khỏi vùng +20 m)
alt Chưa vào vùng nào, hoặc đã phát trong lần vào vùng này
  APP --> User : Không phát thuyết minh
else Vừa đi vào vùng GPS hợp lệ
  APP -> SI : GET /api/user/narrations/{type}/{id}?lang=...
  SI -> SI : Kiểm tra X-Device-Id, X-Session-Token
  SI -> NC : Phiên hợp lệ
  NC -> NS : get(type, id, lang)
  NS -> CS : narration(type, id), visibleTarget(type, id)
  CS -> DB : Đọc nội dung + thuyết minh
  DB --> CS : Bản ghi
  CS --> NS : Narration, TargetInfo
  opt Ngôn ngữ nghe khác ngôn ngữ bản thu
    NS -> TS : translate(text, source, target)
    TS -> DB : Tra / lưu translation_cache
    TS --> NS : Result(text, translated)
  end
  NS --> NC : NarrationDto (text, audioUrl, ttsKey, speed)
  NC --> APP : 200 JSON
  APP --> User : Tự động phát audio hoặc đọc bằng TTS
  APP -> AC : POST /listens và POST /history (method = gps)
  AC -> AS : recordListen(...), addHistory(session, ...)
  AS -> DB : Tăng lượt nghe, ghi lịch sử
  AS --> AC : Hoàn tất
  AC --> APP : 200
end

@enduml
