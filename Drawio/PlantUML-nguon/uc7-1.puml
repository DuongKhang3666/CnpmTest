skinparam packageStyle rectangle
actor "Người dùng" as User
rectangle "Phân hệ Thuyết minh tự động" {
  usecase "UC7.1: Nghe thuyết minh\ntự động" as UC71
  usecase "UC7.1.1: Tự động bằng GPS" as UC711
  usecase "UC7.1.2: Tự động bằng Bluetooth" as UC712
  usecase "UC7.2: Thuyết minh thủ công" as UC72
  usecase "UC7.2.1: Nghe bằng QR code" as UC721
  usecase "UC7.3: Lựa chọn ngôn ngữ" as UC73
  usecase "UC7.4: Dịch nội dung\nvà giao diện" as UC74
}
User --> UC71
User --> UC72
User --> UC73
UC711 .> UC71 : <<extend>>
UC712 .> UC71 : <<extend>>
UC721 .> UC72 : <<extend>>
