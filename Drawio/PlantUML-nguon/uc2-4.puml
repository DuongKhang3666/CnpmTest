@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #222222
skinparam ActivityBackgroundColor #EFEFEF
skinparam ActivityBorderColor #333333
skinparam ActivityDiamondBackgroundColor #EFEFEF
skinparam ActivityDiamondBorderColor #333333
skinparam ActivityBarColor #333333
skinparam UseCaseBackgroundColor #EFEFEF
skinparam UseCaseBorderColor #333333
skinparam ActorBackgroundColor #EFEFEF
skinparam ActorBorderColor #333333
skinparam RectangleBackgroundColor white
skinparam RectangleBorderColor #333333
skinparam ParticipantBackgroundColor #E6E6F5
skinparam ParticipantBorderColor #555555
skinparam DatabaseBackgroundColor #E6E6F5
skinparam DatabaseBorderColor #555555
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceGroupBackgroundColor white
skinparam SequenceGroupBorderColor #333333
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #888888
skinparam dpi 170
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220
actor Admin
participant "Trang Quản lý\nhiện vật (UI)" as UI
participant AdminAuthInterceptor as AUTH
participant JsonServerController as CTL
participant JsonResourceService as SVC
participant JsonResourceRepository as REPO
database "MySQL\n(bảng artifacts)" as DB
Admin -> UI : Mở hiện vật cần sửa, chỉnh thông tin và nhấn "Lưu thay đổi"
activate UI
UI -> UI : Kiểm tra tên, mô tả, địa điểm chứa hiện vật, tọa độ
alt Dữ liệu không hợp lệ
  UI --> Admin : Hiển thị lỗi ("Vui lòng chọn địa điểm chứa hiện vật." ...)
else Dữ liệu hợp lệ
  UI -> AUTH : PATCH /artifacts/{id} (Bearer token)
  activate AUTH
  AUTH -> AUTH : Xác thực token quản trị
  AUTH -> CTL : Chuyển yêu cầu
  deactivate AUTH
  activate CTL
  CTL -> SVC : update("artifacts", id, body)
  activate SVC
  SVC -> REPO : update("artifacts", id, patch)
  activate REPO
  REPO -> DB : SELECT ... WHERE id = ?
  alt Không có hiện vật với id này
    REPO --> SVC : ResourceNotFoundException
    SVC --> CTL : ResourceNotFoundException
    CTL --> UI : 404 Not Found
    UI --> Admin : Hiển thị lỗi ("Không tìm thấy artifacts với id=...")
  else Hiện vật tồn tại
    REPO -> DB : UPDATE artifacts SET ... WHERE id = ?
    DB --> REPO : Bản ghi đã cập nhật
    REPO --> SVC : Bản ghi đã cập nhật
    deactivate REPO
    SVC --> CTL : Bản ghi đã cập nhật
    deactivate SVC
    CTL --> UI : 200 OK
    deactivate CTL
    UI --> Admin : Thông báo "Đã lưu thay đổi.", đóng form, tải lại danh sách
  end
end
deactivate UI

@enduml
