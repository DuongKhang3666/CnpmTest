actor Admin
rectangle "Phân hệ Quản lý Ngôn ngữ" {
  usecase "UC3.1: Xem danh sách\nngôn ngữ" as UC31
  usecase "UC3.2: Thêm ngôn ngữ" as UC32
  usecase "UC3.3: Sửa ngôn ngữ" as UC33
  usecase "UC3.4: Xóa ngôn ngữ" as UC34
  usecase "UC3.5: Bật/tắt\nngôn ngữ" as UC35
  usecase "UC3.6: Kiểm tra dữ liệu,\ntrùng lặp ngôn ngữ" as UC36
}
Admin --> UC31
Admin --> UC32
Admin --> UC33
Admin --> UC34
